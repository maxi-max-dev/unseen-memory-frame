# Copy to .env and run node --env-file=.env server/server.js.
# Keep blank for isolated local storage. Set only for your own CloudBase environment.
MEMORY_CLOUDBASE_ENV=
HOST=127.0.0.1
PORT=8787
# Local mode creates .data/setup-code when blank. Cloud mode requires a private value.
DEMO_SETUP_CODE=
# Text model: use your enabled CloudBase model, or set all three compatible API fields.
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# Vision is separate from the text model; confirm that the provider supports images.
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
# Optional compatible speech transcription API.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
# Keep optional realtime service disabled until billing/configuration/device tests are complete.
AI_REALTIME_ENABLED=0
AI_REALTIME_PROVIDER=tencent-trtc
AI_REALTIME_TRTC_APP_ID=
AI_REALTIME_TRTC_SDK_SECRET=
AI_REALTIME_TRTC_SECRET_ID=
AI_REALTIME_TRTC_SECRET_KEY=
AI_REALTIME_TRTC_TOKEN=
AI_REALTIME_TRTC_REGION=ap-shanghai
AI_REALTIME_TRTC_ROOM_AUTH=0
AI_REALTIME_LLM_JSON=
AI_REALTIME_TTS_JSON=
AI_REALTIME_CLEANUP_ENABLED=0
AI_REALTIME_CLEANUP_STOP_ALL=0

# Optional family calls are disabled until controlled TURN is configured.
MEMORY_CALL_ENABLED=0
MEMORY_CALL_ICE_SERVERS_JSON=
MEMORY_CALL_TURN_SECRET=
